{
  "root": "page",
  "state": { "form": { "name": "", "plan": "" } },
  "elements": {
    "page": {
      "type": "Stack",
      "props": {},
      "children": ["card", "done"]
    },
    "card": {
      "type": "Card",
      "props": { "title": "Start your trial", "subtitle": "Rendered by json-render inside an MCP App" },
      "children": ["name", "plan", "badge", "actions", "saving", "error"],
      "visible": { "$state": "/submission", "not": true }
    },
    "name": {
      "type": "TextField",
      "props": { "label": "Name", "value": { "$bindState": "/form/name" }, "placeholder": "Ada Lovelace" }
    },
    "plan": {
      "type": "Select",
      "props": {
        "label": "Plan",
        "value": { "$bindState": "/form/plan" },
        "options": [
          { "value": "free", "label": "Free" },
          { "value": "pro", "label": "Pro" },
          { "value": "team", "label": "Team" }
        ]
      }
    },
    "badge": {
      "type": "Badge",
      "props": { "label": "Pro selected: priority support included", "tone": "success" },
      "visible": { "$state": "/form/plan", "eq": "pro" }
    },
    "actions": {
      "type": "Stack",
      "props": { "direction": "horizontal", "gap": "sm" },
      "children": ["save", "ask"]
    },
    "save": {
      "type": "Button",
      "props": { "label": "Save", "variant": "secondary" },
      "on": { "press": { "action": "submit", "params": { "form": { "$state": "/form" } } } }
    },
    "ask": {
      "type": "Button",
      "props": { "label": "Ask Claude to recommend" },
      "on": {
        "press": {
          "action": "ask",
          "params": { "message": "Which plan should I pick? Here is what I entered:", "data": { "$state": "/form" } }
        }
      }
    },
    "saving": {
      "type": "Text",
      "props": { "text": "Saving…", "tone": "muted" },
      "visible": { "$state": "/submitting" }
    },
    "error": {
      "type": "Text",
      "props": { "text": { "$template": "Couldn't save: ${/submissionError}" }, "tone": "danger" },
      "visible": { "$state": "/submissionError" }
    },
    "done": {
      "type": "Card",
      "props": { "title": "You're all set", "subtitle": { "$template": "Saved as submission #${/submission/id}" } },
      "children": ["summary", "edit"],
      "visible": { "$state": "/submission" }
    },
    "summary": {
      "type": "Text",
      "props": { "text": { "$template": "${/form/name} is on the ${/form/plan} plan." } }
    },
    "edit": {
      "type": "Button",
      "props": { "label": "Edit", "variant": "secondary" },
      "on": { "press": { "action": "setState", "params": { "statePath": "/submission", "value": null } } }
    }
  }
}
