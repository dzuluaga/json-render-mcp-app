{
  "root": "page",
  "elements": {
    "page": {
      "type": "Stack",
      "props": {
        "gap": "md"
      },
      "children": [
        "header",
        "charts",
        "tasks"
      ]
    },
    "header": {
      "type": "Card",
      "props": {
        "title": "Your week",
        "subtitle": "Nov 2 \u2013 Nov 8"
      },
      "children": [
        "art"
      ]
    },
    "art": {
      "type": "Svg",
      "props": {
        "title": "Sunrise over the week",
        "maxWidth": 360,
        "svg": "<svg viewBox=\"0 0 360 90\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"sky\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#fde68a\"/><stop offset=\"1\" stop-color=\"#fdba74\"/></linearGradient></defs><rect width=\"360\" height=\"90\" rx=\"10\" fill=\"url(#sky)\"/><circle cx=\"180\" cy=\"78\" r=\"30\" fill=\"#f97316\"/><path d=\"M0 78 Q90 50 180 70 T360 62 V90 H0Z\" fill=\"#0f766e\" opacity=\".85\"/><g stroke=\"#f97316\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M180 30v-14\"/><path d=\"M140 42l-9-10\"/><path d=\"M220 42l9-10\"/></g></svg>"
      }
    },
    "charts": {
