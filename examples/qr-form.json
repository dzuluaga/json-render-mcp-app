{
  "root": "card",
  "state": {
    "form": {
      "text": "https://json-render.dev",
      "color": "#4f46e5"
    }
  },
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "QR code maker",
        "description": "The button calls the make_qr_code MCP tool directly"
      },
      "children": [
        "text",
        "colorLabel",
        "color",
        "generate",
        "working",
        "error",
        "result"
      ]
    },
    "text": {
      "type": "Input",
      "props": {
        "label": "Text or URL",
        "name": "text",
        "type": "text",
        "placeholder": "https://…",
        "value": {
          "$bindState": "/form/text"
        }
      }
    },
    "color": {
      "type": "ButtonGroup",
      "props": {
        "buttons": [
          {
            "value": "#000000",
            "label": "Black"
          },
          {
            "value": "#4f46e5",
            "label": "Indigo"
          },
          {
            "value": "#0f766e",
            "label": "Teal"
          },
          {
            "value": "#be123c",
            "label": "Rose"
          }
        ],
        "selected": {
          "$bindState": "/form/color"
        }
      }
    },
    "generate": {
      "type": "Button",
      "props": {
        "label": "Generate"
      },
      "on": {
        "press": {
          "action": "callTool",
          "params": {
            "name": "make_qr_code",
            "arguments": {
              "text": {
                "$state": "/form/text"
              },
              "color": {
                "$state": "/form/color"
              }
            },
            "resultPath": "/qr"
          }
        }
      }
    },
    "working": {
      "type": "Text",
      "props": {
        "text": "Generating…",
        "variant": "muted"
      },
      "visible": {
        "$state": "/calls/make_qr_code/status",
        "eq": "pending"
      }
    },
    "error": {
      "type": "Alert",
      "props": {
        "title": {
          "$template": "Couldn't generate: ${/calls/make_qr_code/error}"
        },
        "type": "error"
      },
      "visible": {
        "$state": "/calls/make_qr_code/status",
        "eq": "error"
      }
    },
    "result": {
      "type": "Stack",
      "props": {
        "gap": "sm"
      },
      "children": [
        "qr",
        "caption"
      ],
      "visible": {
        "$state": "/qr"
      }
    },
    "qr": {
      "type": "Image",
      "props": {
        "src": {
          "$state": "/qr/src"
        },
        "alt": "QR code",
        "maxWidth": 220
      }
    },
    "caption": {
      "type": "Text",
      "props": {
        "text": {
          "$template": "Encodes: ${/qr/text}"
        },
        "variant": "muted"
      }
    },
    "colorLabel": {
      "type": "Text",
      "props": {
        "text": "Colour",
        "variant": "caption"
      }
    }
  }
}
