{
  "name": "json-render-mcp-app",
  "version": "0.1.0",
  "description": "An MCP App where Claude draws interactive UI with json-render",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:ui": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run typecheck && npm run build:ui && npm run build:server",
    "start": "node dist/main.js",
    "start:stdio": "node dist/main.js --stdio",
    "test": "vitest run",
    "dev": "vite"
  },
  "type": "module",
  "dependencies": {
    "@json-render/core": "^0.22.0",
    "@json-render/react": "^0.22.0",
    "@json-render/shadcn": "^0.22.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.70.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "react-is": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "private": true,
  "license": "MIT",
  "bin": {
    "json-render-mcp-app": "dist/main.js"
  },
  "overrides": {
    "react-is": "$react-is"
  }
}
